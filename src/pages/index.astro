---
import Layout from "../layouts/Layout.astro";
import SchemaOrganization from "../components/SchemaOrganization.astro";
import SchemaWebsite from "../components/SchemaWebsite.astro";
import Komisariatdepan from "../components/komisariatdepan.astro";
import Apaitupmiidepan from "../components/apaitupmiidepan.astro";
import Keunggulan from "../components/keunggulan.astro";
import { SITE_TITLE, SITE_DESCRIPTION } from "../consts";

const image = "https://pmiikomfakdish.or.id/assets/images/Foto-Depan-PMIKOMFAKDISH.jpg";
---

<Layout title={SITE_TITLE} description={SITE_DESCRIPTION} image={image}>
  <SchemaOrganization />
  <SchemaWebsite />
  <Komisariatdepan />
  <Apaitupmiidepan />
  <Keunggulan />
</Layout>