---
import { createPersonSchema } from '../utils/schema';

interface Props {
  name: string;
  role: string;
  image?: string;
  phone?: string;
  email?: string;
}

const { name, role, image, phone, email } = Astro.props;
const schema = createPersonSchema({
  name,
  role,
  image,
  phone,
  email,
});
---

<script type="application/ld+json" set:html={JSON.stringify(schema)} />
